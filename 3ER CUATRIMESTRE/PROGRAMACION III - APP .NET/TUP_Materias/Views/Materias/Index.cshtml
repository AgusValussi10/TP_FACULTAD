@*
    @model le dice a la vista qué tipo de dato va a recibir del controlador.
    Acá esperamos una lista de objetos Materia.
*@
@model List<TUP_Materias.Models.Materia>

@{
    ViewData["Title"] = "Materias TUP";
}

<h1 class="mb-4">Materias de la Tecnicatura</h1>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Materia</th>
            <th>Profesor a cargo</th>
            <th>Alumnos inscriptos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @*
            @foreach recorre la lista que mandó el controlador.
            Cada "materia" es un objeto Materia con sus propiedades.
        *@
        @foreach (var materia in Model)
        {
            <tr>
                <td>@materia.Nombre</td>
                <td>@materia.Profesor.NombreCompleto</td>
                <td>@materia.Alumnos.Count alumnos</td>
                <td>
                    @* asp-action y asp-route-id generan la URL /Materias/Detalle/{id} *@
                    <a asp-controller="Materias" asp-action="Detalle" asp-route-id="@materia.Id"
                       class="btn btn-primary btn-sm">Ver detalle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
